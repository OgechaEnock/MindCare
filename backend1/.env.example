# ─── MindCare Backend — Environment Template ────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.

# ─── Server ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development        # development | testing | production
FLASK_ENV=development        # Must match NODE_ENV

# ─── Flask Core ─────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_HEX_STRING

# ─── JWT (Flask-JWT-Extended) ───────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_HEX_STRING
JWT_ACCESS_TOKEN_EXPIRES=15m       # Short-lived access token
JWT_REFRESH_TOKEN_EXPIRES=7d       # Long-lived refresh token

# ─── PostgreSQL ─────────────────────────────────────────────────────────
DB_USER=<your_db_user>
DB_PASSWORD=<your_strong_db_password>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xxxx
DATABASE_URL=                       # Optional: full SQLAlchemy URL

# ─── Encryption (AES-256, must be ≥ 32 chars) ───────────────────────────
# Must match the key used by the Node.js backend for existing encrypted data
ENCRYPTION_KEY=CHANGE_ME_TO_A_32_PLUS_CHAR_STRING

# ─── Redis (rate-limit storage) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Moderation API (internal, localhost only) ──────────────────────────
MODERATION_API_URL=http://127.0.0.1:8000/generate/
MODERATION_TIMEOUT_MS=30000

# ─── Frontend (CORS whitelist — only trusted origins) ───────────────────
FRONTEND_URL=http://localhost:3000

# ─── Password Hashing ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12                    # Increase for production (default 12)

# ─── Proxy (for nginx reverse proxy) ────────────────────────────────────
PROXY_FIX_X_FOR=2
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
